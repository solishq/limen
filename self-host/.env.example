# ============================================================================
# Limen MCP Server — Environment Configuration
# ============================================================================
# Copy this file to .env and edit values as needed.
# All variables have sensible defaults for local development.
# ============================================================================

# --- Core Configuration ---

# Path to the SQLite data directory inside the container.
# Mapped to a Docker volume for persistence.
# Default: /data (mapped to the limen-data volume)
# LIMEN_DATA_DIR=/data

# Master key for Limen encryption.
# Option A: File mount (default) — path inside container to the key file.
#   The docker-compose secrets mechanism mounts this at /run/secrets/master_key.
#   Generate a key: openssl rand -hex 32 > master.key
# LIMEN_MASTER_KEY_PATH=/run/secrets/master_key

# Option B: Inline hex-encoded key (overrides file mount).
#   Useful for environments where file mounts are unavailable (e.g., some CI systems).
#   Generate: openssl rand -hex 32
# LIMEN_MASTER_KEY=

# Path to the master key file on the HOST (used by docker-compose secrets).
# Default: ./master.key (relative to docker-compose.yml)
# LIMEN_MASTER_KEY_FILE=./master.key

# --- Node.js ---

# Node.js environment. Always "production" for deployed instances.
NODE_ENV=production

# --- Monitoring (--profile monitor) ---

# Prometheus external port
# PROMETHEUS_PORT=9090

# Grafana external port
# GRAFANA_PORT=3000

# Grafana admin password (change in production)
# GRAFANA_ADMIN_PASSWORD=admin
